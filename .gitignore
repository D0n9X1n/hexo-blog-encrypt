# Dependencies. package-lock.json at the root is committed (CI uses npm ci).
node_modules/

# Coverage
coverage/
.nyc_output/

# Test outputs
test-results/
tests/e2e/playwright-report/
tests/e2e/test-results/
tests/e2e/.runtime.json
tests/e2e/.themes.json
pack.json

# Fixture site: generated output, Hexo cache, and posts materialized at test
# time from tests/fixtures/hexo-site/templates/ (only .gitkeep is tracked).
# Its lockfile stays untracked so CI can switch Hexo majors.
tests/fixtures/hexo-site/public/
tests/fixtures/hexo-site/db.json
tests/fixtures/hexo-site/package-lock.json
tests/fixtures/hexo-site/source/_posts/*.md

# Demo site: deploy-demo.yml installs it with `npm install` from a semver
# range, so its lockfile stays untracked.
demo/package-lock.json

# Browser bundle, built by `npm run build` (prepare / prepack)
lib/hbe.bundle.js
lib/hbe.bundle.js.map

# OS
.DS_Store

# Local Claude Code state (settings, worktrees). Only CLAUDE.md is committed.
.claude/
__pycache__/
